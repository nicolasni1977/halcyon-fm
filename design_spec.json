  "js_architecture": {
    "file_structure": "Single index.html, all CSS and JS inlined",
    "js_sections": [
      {
        "id": 1,
        "name": "Constants & Config",
        "contents": "State enum, keyCodes, sector angles, timing constants, localStorage keys"
      },
      {
        "id": 2,
        "name": "AudioEngine",
        "contents": "Lazy AudioContext init, pre-generated noise buffers, tick/button/confirm/powerOn/powerOff functions, iOS unlock"
      },
      {
        "id": 3,
        "name": "LibraryManager",
        "contents": "IndexedDB open/migrate, addTrack, getTracks, deleteTrack, getBlobURL, demo-asset loader"
      },
      {
        "id": 4,
        "name": "ID3Parser",
        "contents": "parseID3(arrayBuffer) → {title,artist,album,trackNum,coverBlob}; handles v2.3+v2.4, ISO-8859-1+UTF-16"
      },
      {
        "id": 5,
        "name": "StateManager",
        "contents": "appState object, transition table, dispatch(action, payload), enterState handlers per state"
      },
      {
        "id": 6,
        "name": "WheelEngine",
        "contents": "Class WheelEngine(element, center): pointerdown/move/up with setPointerCapture, atan2 accumulation, tick emission, sector tap, long-press timers"
      },
      {
        "id": 7,
        "name": "ScreenRenderer",
        "contents": "render(state, appState) switch — shows/hides screen divs, updates menu rows, scrubber, art, status bar"
      },
      {
        "id": 8,
        "name": "BootSequence",
        "contents": "runBoot(): plays powerOn sweep, drives Halcyon fade-in/hold/fade-out, transitions to MAIN_MENU"
      },
      {
        "id": 9,
        "name": "EventBindings",
        "contents": "keyboard handler, drag-drop handler, hold switch click, resize/ResizeObserver for --ipod-scale, audio timeupdate/ended"
      },
      {
        "id": 10,
        "name": "Init",
        "contents": "DOMContentLoaded: open DB, load library meta, calculate scale, render initial state, start boot if first load"
      }
    ],
    "css_sections": [
      "1. Reset & page background",
      "2. Device shell & edges (layered gradients, shadows)",
      "3. Screen module & bezel",
      "4. Status bar",
      "5. Split-pane layout",
      "6. Menu rows & selection highlight gradient",
      "7. Album art pane",
      "8. Click wheel (donut ring) & center button",
      "9. Now Playing layout",
      "10. Overlays (hold status, backlight dim, quick-scroll, context menu, shortcuts, drag-drop)",
      "11. Animations & transitions (boot fade, backlight, cover flow)",
      "12. Responsive scaling (--ipod-scale custom property, transform: scale on device wrapper)"
    ],
    "state_machine": {
      "states": [
        "OFF",
        "BOOTING",
        "MAIN_MENU",
        "SUBMENU",
        "COVER_FLOW",
        "NOW_PLAYING",
        "SETTINGS"
      ],
      "transitions": {
        "OFF→BOOTING": "any button/key press",
        "BOOTING→MAIN_MENU": "after 1800ms boot animation",
        "MAIN_MENU→SUBMENU": "SELECT on Music/Videos/Photos/Podcasts/Extras",
        "MAIN_MENU→NOW_PLAYING": "SELECT on Now Playing, or auto when track starts",
        "MAIN_MENU→SETTINGS": "SELECT on Settings",
        "SUBMENU→SUBMENU": "SELECT to drill deeper",
        "SUBMENU→COVER_FLOW": "SELECT on Cover Flow item",
        "SUBMENU→NOW_PLAYING": "SELECT on a track",
        "SUBMENU→MAIN_MENU": "MENU at depth 1",
        "NOW_PLAYING→SUBMENU": "MENU button",
        "any→hold_overlay": "hold switch toggle (state preserved)",
        "any→OFF": "PLAY/PAUSE 1500ms long press"
      }
    },
    "local_storage_keys": {
      "halcyon-settings": "JSON: {clicker, backlightTimer, brightness, eq, repeat, shuffle}",
      "halcyon-library-meta": "Array of {id, title, artist, album, trackNum, duration} without blobs",
      "halcyon-playlists": "Array of {name, trackIds} including On-The-Go",
      "halcyon-ratings": "Object: trackId → 0-5",
      "halcyon-playcounts": "Object: trackId → number"
    },
    "indexeddb": {
      "db_name": "halcyon-db",
      "version": 1,
      "stores": {
        "tracks": "keyPath: id (auto-increment); fields: title, artist, album, trackNum, duration, audioBlob, coverBlob"
      }
    },
    "backlight_system": {
      "interval": "setInterval every 1000ms checks Date.now() - lastInteractionTime",
      "dim_element": "overlay_backlight div",
      "consumed_by_wake_flag": "_consumedByWake — set in pointerdown/keydown when dimmed, cleared after backlight-wake check in pointerup/keyup",
      "wake_action": "set dim overlay opacity to 0, reset lastInteractionTime, set _consumedByWake=true, return early"
    },
    "mosaic_svg_spec": {
      "function": "generateMosaicSVG(seed: number) → string (inline SVG)",
      "rng": "LCG: next = (seed * 1664525 + 1013904223) & 0xFFFFFFFF",
      "grid": "5x5 = 25 cells",
      "palette": [
        "#FF4B8B",
        "#8A2BE2",
        "#FF6420",
        "#FFB800",
        "#3A78D8",
        "#4CD964",
        "#FF2D55",
        "#AF52DE"
      ],
      "extras": "~30% cells get a diagonal linearGradient overlay at 0.3 opacity; no solid-color fallback",
      "output_use": "data:image/svg+xml URI for background-image OR innerHTML of right_art_pane"
    }
  },
  "navigation_flow": {
    "primary_input": "Click wheel (pointer events with setPointerCapture)",
    "secondary_input": "Keyboard shortcuts",
    "hold_guard": "All inputs check holdState first; if active, silent consume and return",
    "backlight_guard": "All inputs check backlightDim; if dimmed, wake + _consumedByWake, return",
    "keyboard_map": {

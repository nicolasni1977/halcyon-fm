{
  "project_name": "Halcyon iPod Classic Webapp",
  "iteration": 1,
  "chosen_archetypes": {
    "primary": "Data-Dense / Bloomberg",
    "secondary": "Brutalist / Anti-Design",
    "exemplar_anchors": [
      "Bloomberg Terminal",
      "BasicAppleGuy",
      "Superhuman"
    ],
    "rationale": "The iPod Classic OS is itself a data-dense, information-first UI: monospaced-feeling pixel-precise rows, tabular scrubber times, keyboard-first interaction model, and zero decorative chrome. Data-Dense provides the density discipline and functional-color-only philosophy. Brutalist secondary archetype grounds the skeuomorphic hardware shell in authentic rawness — no gratuitous gradients beyond those demanded by physical material simulation, no ornamental SVG, no rounded-card defaults. Together they produce an interface that feels like a real instrument, not a website pretending to be one.",
    "signature_interaction": "Click-wheel angular drag: pointer capture with atan2 accumulation emitting haptic-tick sounds every 12° of rotation — the single interaction that defines the whole product."
  },
  "design_system": {
    "colors": {
      "primary": {
        "value": "#3A78D8",
        "usage": "Menu selection highlight top, active states, scrubber fill"
      },
      "primary_gradient_end": {
        "value": "#5A99F0",
        "usage": "Menu selection highlight bottom gradient stop"
      },
      "primary_light": {
        "value": "#EAF0FB",
        "usage": "Subtle hover backgrounds inside screen"
      },
      "accent_orange": {
        "value": "#FF6A00",
        "usage": "Hold switch indicator, status-bar lock icon"
      },
      "body_silver_lit": {
        "value": "#D6D8DA",
        "usage": "Device body center — brushed aluminum base"
      },
      "body_silver_shadow": {
        "value": "#C8CACE",
        "usage": "Device body edge gradient"
      },
      "body_rim": {
        "value": "#9A9CA0",
        "usage": "Device rim border/shadow"
      },
      "screen_bezel": {
        "value": "#1a1a1a",
        "usage": "LCD bezel border, screen-off state"
      },
      "wheel_white": {
        "value": "#F8F8F8",
        "usage": "Click wheel outer ring surface"
      },
      "wheel_label_grey": {
        "value": "#A0A0A4",
        "usage": "MENU / icon labels on wheel"
      },
      "battery_green": {
        "value": "#4CD964",
        "usage": "Battery pill fill"
      },
      "status_bar_bg": {
        "value": "#F0F0F0",
        "usage": "Status bar background"
      },
      "screen_white": {
        "value": "#FFFFFF",
        "usage": "Left menu pane background"
      },
      "page_bg_center": {
        "value": "#1a1a1f",
        "usage": "Page radial gradient center"
      },
      "page_bg_edge": {
        "value": "#0d0d10",
        "usage": "Page radial gradient edge"
      },
      "neutral_900": {
        "value": "#1a1a1a",
        "usage": "Primary text, menu items"
      },
      "neutral_700": {
        "value": "#555555",
        "usage": "Artist name, secondary text"
      },
      "neutral_500": {
        "value": "#777777",
        "usage": "Album name, tertiary text"
      },
      "neutral_300": {
        "value": "#CCCCCC",
        "usage": "Empty rating stars, scrubber unfilled"
      },
      "neutral_200": {
        "value": "#C0C0C0",
        "usage": "Pane divider line, borders"
      },
      "top_edge": {
        "value": "#B0B2B5",
        "usage": "Top/bottom edge strips"
      },
      "success": {
        "value": "#4CD964",
        "usage": "Success states"
      },
      "warning": {
        "value": "#FFB800",
        "usage": "Rating stars filled"
      },
      "error": {
        "value": "#FF3B30",
        "usage": "Error states"
      }
    },
    "typography": {
      "font_heading": "Georgia, serif",
      "font_body": "'Helvetica Neue', Helvetica, Arial, sans-serif",
      "font_mono": "'Courier New', Courier, monospace",
      "note": "No web font imports — system fonts only. All screen sizes scaled via --ipod-font-scale CSS custom property.",
      "scale": {
        "boot_wordmark": {
          "size": "22px",
          "weight": "400",
          "line_height": "1.2",
          "font": "Georgia, serif"
        },
        "menu_item": {
          "size": "13px",
          "weight": "400",
          "line_height": "1.0"
        },
        "track_title": {
          "size": "12px",
          "weight": "700",
          "line_height": "1.2"
        },
        "artist_name": {
          "size": "11px",
          "weight": "400",
          "line_height": "1.2"
        },
        "album_name": {
          "size": "10px",
          "weight": "400",
          "line_height": "1.2"
        },
        "status_label": {
          "size": "10px",
          "weight": "700",
          "line_height": "1.0"
        },
        "scrubber_time": {
          "size": "10px",
          "weight": "400",
          "line_height": "1.0"
        },
        "wheel_label": {
          "size": "10px",
          "weight": "700",
          "letter_spacing": "0.1em"
        },
        "quick_scroll_letter": {
          "size": "60px",
          "weight": "700",
          "line_height": "1.0"
        },
        "submenu_breadcrumb": {
          "size": "11px",
          "weight": "700",
          "line_height": "1.0"
        }
      }
    },
    "spacing": {
      "unit": "8px",
      "scale": "4px, 8px, 12px, 16px, 24px, 32px, 48px, 64px, 96px, 128px",
      "screen_row_height": "15px",
      "status_bar_height": "18px",
      "menu_left_padding": "8px",
      "screen_margin_from_body": "8px"
    },
    "borders": {
      "radius_device": "14px",
      "radius_screen_inner": "3px",
      "radius_bezel": "5px",
      "radius_wheel": "50%",
      "radius_center_btn": "50%",
      "radius_battery": "3px",
      "radius_hold_switch": "3px",
      "radius_dock_slot": "2px"
    },
    "shadows": {
      "device_drop": "0 20px 60px rgba(0,0,0,0.55), 0 4px 12px rgba(0,0,0,0.35)",
      "device_inset_top": "inset 0 1px 0 rgba(255,255,255,0.4)",
      "screen_bezel_inset": "inset 0 1px 3px rgba(0,0,0,0.5)",
      "center_btn_inset": "inset 0 1px 3px rgba(0,0,0,0.25)",
      "wheel_gloss": "radial-gradient from rgba(255,255,255,0.7) top-left to transparent",
      "dock_slot_inset": "inset 0 1px 3px rgba(0,0,0,0.6)"
    },
    "breakpoints": {
      "mobile_portrait": "0-480px",
      "mobile_landscape": "481-767px",
      "tablet": "768-1023px",
      "desktop": "1024px+"
    },
    "transitions": {
      "instant": "60ms ease-out",
      "fast": "150ms ease-out",
      "normal": "250ms ease-out",
      "screen_fade": "400ms ease",
      "boot_fade_in": "600ms ease",
      "boot_fade_out": "400ms ease",
      "coverflow_slide": "300ms cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    },
    "device_dimensions": {
      "reference_height_px": 430,
      "reference_width_px": 257,
      "aspect_ratio": "1.674:1 (height:width)",
      "scaling_formula": "min(calc(100vh - 80px), calc(100vw * 1.674))",
      "css_custom_property": "--ipod-scale",
      "mobile_width_target": "90vw"
    }
  },
  "components": [
    {
      "component_id": "device_shell",
      "type": "container",
      "description": "Outer brushed aluminum iPod body",
      "styles": {
        "default": {
          "aspect_ratio": "257 / 430",
          "border_radius": "{borders.radius_device}",
          "background": "layered: (1) radial-gradient(ellipse at 40% 30%, #D6D8DA 0%, #C8CACE 60%, #B8BABD 100%) — base aluminum; (2) repeating-linear-gradient(90deg, transparent 0px, rgba(255,255,255,0.015) 1px, transparent 2px) — grain stripes; (3) linear-gradient(180deg, rgba(255,255,255,0.08) 0%, rgba(0,0,0,0.06) 100%) — top-to-bottom lighting",
          "box_shadow": "{shadows.device_drop}, {shadows.device_inset_top}, inset 0 0 0 1px rgba(154,156,160,0.6)",
          "position": "relative",
          "overflow": "hidden"
        }
      }
    },
    {
      "component_id": "top_edge_strip",
      "type": "container",
      "description": "Top hardware edge with hold switch and headphone jack",
      "styles": {
        "default": {
          "height": "8px",
          "background": "{colors.top_edge}",
          "border_radius": "{borders.radius_device} {borders.radius_device} 0 0",
          "position": "absolute",
          "top": "0",
          "left": "0",
          "right": "0"
        }
      }
    },
    {
      "component_id": "hold_switch",
      "type": "interactive",
      "description": "Toggleable hold switch slider",
      "variants": [
        "default",

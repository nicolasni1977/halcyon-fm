      ],
      "styles": {
        "default": {
          "width": "24px",
          "height": "5px",
          "background": "#999",
          "border_radius": "{borders.radius_hold_switch}",
          "position": "absolute",
          "left": "12px",
          "top": "1.5px",
          "cursor": "pointer"
        },
        "engaged": {
          "background": "{colors.accent_orange}",
          "box_shadow": "0 0 4px rgba(255,106,0,0.5)"
        }
      }
    },
    {
      "component_id": "headphone_jack",
      "type": "decorative",
      "description": "3.5mm headphone port visual",
      "styles": {
        "default": {
          "width": "6px",
          "height": "6px",
          "border_radius": "50%",
          "background": "#1a1a1a",
          "border": "1px solid #555",
          "box_shadow": "inset 0 1px 2px rgba(0,0,0,0.8)",
          "position": "absolute",
          "right": "16px",
          "top": "1px"
        }
      }
    },
    {
      "component_id": "screen_module",
      "type": "container",
      "description": "LCD screen with bezel",
      "styles": {
        "default": {
          "position": "absolute",
          "top": "20px",
          "left": "8px",
          "right": "8px",
          "aspect_ratio": "3 / 2",
          "background": "{colors.screen_bezel}",
          "border": "3px solid {colors.screen_bezel}",
          "border_radius": "{borders.radius_bezel}",

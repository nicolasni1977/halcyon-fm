      "description": "Full-screen 3D CSS carousel for Cover Flow view",
      "styles": {
        "default": {
          "position": "absolute",
          "inset": "0",
          "background": "#000000",
          "transform_style": "preserve-3d",
          "perspective": "800px",
          "overflow": "hidden"
        }
      }
    },
    {
      "component_id": "cover_flow_card",
      "type": "interactive",
      "description": "Individual album card in Cover Flow",
      "variants": [
        "center",
        "adjacent_left",
        "adjacent_right",
        "far_left",
        "far_right"
      ],
      "styles": {
        "center": {
          "transform": "rotateY(0deg) scale(1.1)",
          "z_index": 5,
          "transition": "{transitions.coverflow_slide}"
        },
        "adjacent_left": {
          "transform": "rotateY(45deg) translateX(-40%) scale(0.85)",
          "z_index": 4
        },
        "adjacent_right": {
          "transform": "rotateY(-45deg) translateX(40%) scale(0.85)",
          "z_index": 4
        },
        "far_left": {
          "transform": "rotateY(75deg) translateX(-70%) scale(0.7)",
          "z_index": 3
        },
        "far_right": {
          "transform": "rotateY(-75deg) translateX(70%) scale(0.7)",
          "z_index": 3
        }
      }
    },

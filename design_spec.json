          "display": "flex",
          "align": "center",
          "justify": "center",
          "z_index": 60,
          "pointer_events": "none"
        },
        "letter": {
          "font_size": "60px",
          "font_weight": "700",
          "color": "#FFFFFF",
          "font_family": "{typography.font_body}"
        }
      }
    },
    {
      "component_id": "overlay_context_menu",
      "type": "overlay",

    {
      "component_id": "mosaic_svg_art",
      "type": "visual",
      "description": "Procedural deterministic mosaic SVG default album art",
      "generation_spec": {
        "grid": "5x5 rectangles",
        "rng": "LCG seeded by track.id or 0 for default",
        "palette": [

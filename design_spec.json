        "default": {
          "position": "absolute",
          "font_size": "10px",
          "font_weight": "700",
          "letter_spacing": "0.1em",
          "color": "{colors.wheel_label_grey}",
          "pointer_events": "none",
          "user_select": "none"
        }
      }
    },
    {
      "component_id": "bottom_edge_strip",
      "type": "decorative",
      "description": "Bottom edge with dock connector",
      "styles": {
        "default": {
          "height": "8px",
          "background": "{colors.top_edge}",
          "position": "absolute",
          "bottom": "0",
          "left": "0",
          "right": "0",
          "border_radius": "0 0 {borders.radius_device} {borders.radius_device}",
          "display": "flex",
          "align": "center",
          "justify": "center"
        }
      }
    },
    {
      "component_id": "dock_connector_slot",
      "type": "decorative",

        }
      }
    },
    {
      "component_id": "scrubber_bar",
      "type": "interactive",
      "description": "Full-width playback scrubber at bottom of screen",
      "styles": {
        "default": {
          "height": "16px",
          "padding": "0 6px",
          "display": "flex",
          "align": "center",
          "gap": "4px",
          "background": "{colors.screen_white}",
          "border_top": "1px solid {colors.neutral_200}",
          "flex_shrink": "0"
        },
        "track": {
          "flex": "1",
          "height": "3px",
          "background": "{colors.neutral_300}",
          "border_radius": "2px",
          "overflow": "hidden"
        },
        "fill": {
          "height": "100%",
          "background": "{colors.primary}",
          "border_radius": "2px",
          "transition": "width 250ms linear"
        },
        "time_label": {
          "font_size": "10px",
          "color": "{colors.neutral_500}",
          "white_space": "nowrap",
          "min_width": "28px"
        }
      }
    },
    {
      "component_id": "overlay_backlight_dim",
      "type": "overlay",
      "description": "Semi-transparent dim overlay over screen on idle",
      "styles": {
        "default": {
          "position": "absolute",
          "inset": "0",
          "background": "rgba(0,0,0,0.0)",
          "z_index": 50,
          "transition": "background {transitions.screen_fade}",
